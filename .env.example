# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore en wordt NOOIT gecommit.

# PostgreSQL connection string — NU ACTIEF GEBRUIKT vanaf Fase 8, voor
# multi-store beheer (elke store veilig, versleuteld opgeslagen).
# Lokaal: wijst naar je eigen Postgres-installatie (bv. Postgres.app).
# Railway: wordt automatisch aangeleverd zodra je de Postgres-service koppelt.
DATABASE_URL="postgresql://gebruikersnaam@localhost:5432/competitor_import_tool"

# Encryptiesleutel voor het versleutelen van Shopify access tokens in de
# database. Genereer een nieuwe met: openssl rand -hex 32
# BELANGRIJK: verlies je deze sleutel, dan kunnen opgeslagen tokens niet meer
# ontsleuteld worden — bewaar 'm net zo zorgvuldig als een wachtwoord.
ENCRYPTION_KEY=""

# Anthropic API key — voor content-generatie, vertaling en vision
ANTHROPIC_API_KEY=""

# Shopify-stores worden vanaf Fase 8 beheerd via het dashboard zelf
# (Stores-paneel), niet meer via environment variables. De onderstaande
# regels zijn dus niet meer nodig, maar worden hier als referentie bewaard.
# SHOPIFY_TEST_STORE_DOMAIN="wilson-co-london.myshopify.com"
# SHOPIFY_TEST_STORE_ACCESS_TOKEN=""
# SHOPIFY_TEST_STORE_NAME="Wilson & Co London"
